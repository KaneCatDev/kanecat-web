{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kanecat-web",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-08",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ADMIN_EMAIL": "contact@kanecat.dev",
    "FROM_EMAIL": "KaneCatDev <noreply@kanecat.dev>"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/contact",
      "/api/gakeyru-test"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
